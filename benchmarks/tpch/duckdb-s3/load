#!/bin/bash
set -e

# No ingestion: tpch.db holds one view per table over its parquet files in the
# bucket. A view binds to its files when it is created, so the session carries
# a secret for the bucket (./power makes its own again): the credentials in
# the environment, or none when there are none and the bucket is public, read
# unsigned.
if [ -n "${BENCH_S3_ANONYMOUS:-}" ]; then provider=""; else provider="PROVIDER credential_chain, "; fi
rm -f tpch.db
{
    echo "CREATE SECRET (TYPE s3, ${provider}REGION '$AWS_REGION');"
    for table in $(aws s3 ls ${BENCH_S3_ANONYMOUS:+--no-sign-request} "$BENCH_S3/" | awk '/ PRE / { print substr($2, 1, length($2) - 1) }'); do
        echo "CREATE VIEW $table AS FROM read_parquet('$BENCH_S3/$table/*.parquet');"
    done
} | duckdb tpch.db >/dev/null
