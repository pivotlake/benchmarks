#!/bin/bash
set -eu

[ -f server.pid ] || exit 0
pid=$(cat server.pid)
kill "$pid" 2>/dev/null || true

# The server holds most of the machine's memory until it exits; a successor
# started before then risks an OOM kill.
for _ in $(seq 1 300); do
    if ! kill -0 "$pid" 2>/dev/null; then
        rm -f server.pid
        exit 0
    fi
    sleep 0.2
done
echo "stop: pivot (pid $pid) is still running after 60s" >&2
exit 1
