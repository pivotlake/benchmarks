#!/bin/bash
set -e

# No ingestion: tables.sql defines one File(Parquet) table per directory, read
# in place. ./query runs it ahead of every query.
for table in "$BENCH_DATA"/*/; do
    table=$(basename "$table")
    echo "CREATE TABLE $table ENGINE = File(Parquet, '$BENCH_DATA/$table/*.parquet');"
done > tables.sql
